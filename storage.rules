rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /public/{allPaths=**} { allow read: if true; allow write: if admin(); }
    match /private/{allPaths=**} { allow read, write: if admin(); }
  }
}
